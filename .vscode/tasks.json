{
  // Tasks that wrap the EXISTING player scripts. They do not change what the
  // scripts do; they only make them one-click runnable from the editor.
  // deploy-test.sh calls ./build_mac.sh and uses relative paths, so all tasks
  // run with cwd = player/.
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Player: Build (ARM cross-compile)",
      "type": "shell",
      "command": "./build_mac.sh",
      "options": {
        "cwd": "${workspaceFolder}/player"
      },
      "problemMatcher": [],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "detail": "Cross-compile dvdplayer_headless for SS1 (arm-unknown-linux-gnueabihf, VFPv3). Enforces the no-VFPv4 gate."
    },
    {
      "label": "FB Test: Build (ARM cross-compile)",
      "type": "shell",
      "command": "./build_fb_test.sh",
      "options": {
        "cwd": "${workspaceFolder}/player/tools"
      },
      "problemMatcher": [],
      "group": "build",
      "detail": "Cross-compile the minimal HPS framebuffer test (fb_native_test) with the VFPv3-safe toolchain."
    },
    {
      "label": "FB Test: Deploy + Run on SS1",
      "type": "shell",
      "command": "./deploy_fb_test.sh",
      "options": {
        "cwd": "${workspaceFolder}/player/tools"
      },
      "problemMatcher": [],
      "group": "test",
      "detail": "Build, scp and run fb_native_test on the SS1. Run from the MiSTer menu core so the framebuffer state can be restored."
    },
    {
      "label": "DDR Writer: Build (ARM cross-compile)",
      "type": "shell",
      "command": "./build_ddr_writer.sh",
      "options": {
        "cwd": "${workspaceFolder}/player/tools"
      },
      "problemMatcher": [],
      "group": "build",
      "detail": "Cross-compile the MISTER_FB DDR framebuffer writer (ddr_fb_writer) with the VFPv3-safe toolchain."
    },
    {
      "label": "DDR Writer: Deploy + Run on SS1",
      "type": "shell",
      "command": "./deploy_ddr_writer.sh",
      "options": {
        "cwd": "${workspaceFolder}/player/tools"
      },
      "problemMatcher": [],
      "group": "test",
      "detail": "Build, scp and run ddr_fb_writer on the SS1. Requires the DVD core (DVD.rbf) to be loaded first."
    },
    {
      "label": "DDR Double Writer: Build (ARM cross-compile)",
      "type": "shell",
      "command": "./build_ddr_double_writer.sh",
      "options": {
        "cwd": "${workspaceFolder}/player/tools"
      },
      "problemMatcher": [],
      "group": "build",
      "detail": "Cross-compile ddr_fb_double_writer: fills MISTER_FB buffers A and B with distinct static patterns."
    },
    {
      "label": "DDR Double Writer: Deploy + Run on SS1",
      "type": "shell",
      "command": "./deploy_ddr_double_writer.sh",
      "options": {
        "cwd": "${workspaceFolder}/player/tools"
      },
      "problemMatcher": [],
      "group": "test",
      "detail": "Build, scp and run ddr_fb_double_writer on the SS1. Load DVD.rbf first, then toggle Buffer A/B in the OSD."
    },
    {
      "label": "DDR Flip Test: Build (ARM cross-compile)",
      "type": "shell",
      "command": "./build_ddr_flip_test.sh",
      "options": {
        "cwd": "${workspaceFolder}/player/tools"
      },
      "problemMatcher": [],
      "group": "build",
      "detail": "Cross-compile ddr_fb_flip_test: ~300 ARM mailbox flips between buffers A and B."
    },
    {
      "label": "DDR Flip Test: Deploy + Run on SS1",
      "type": "shell",
      "command": "./deploy_ddr_flip_test.sh",
      "options": {
        "cwd": "${workspaceFolder}/player/tools"
      },
      "problemMatcher": [],
      "group": "test",
      "detail": "Build, scp and run ddr_fb_flip_test on the SS1. Load a mailbox-capable DVD.rbf first. Leave OSD Buffer on A."
    },
    {
      "label": "DVD Frame Test: Build (ARM cross-compile)",
      "type": "shell",
      "command": "./build_dvd_frame_test.sh",
      "options": {
        "cwd": "${workspaceFolder}/player/tools"
      },
      "problemMatcher": [],
      "group": "build",
      "detail": "Cross-compile the single-frame DVD -> MISTER_FB test (dvd_frame_test) with the VFPv3-safe toolchain. Requires FFmpeg libs from build_mac.sh."
    },
    {
      "label": "DVD Frame Test: Deploy + Run on SS1",
      "type": "shell",
      "command": "./deploy_dvd_frame_test.sh",
      "options": {
        "cwd": "${workspaceFolder}/player/tools"
      },
      "problemMatcher": [],
      "group": "test",
      "detail": "Build, scp and run dvd_frame_test on the SS1. Requires the DVD core loaded and a PAL DVD in /dev/sr0."
    },
    {
      "label": "DVD Video Test: Build (ARM cross-compile)",
      "type": "shell",
      "command": "./build_dvd_video_test.sh",
      "options": {
        "cwd": "${workspaceFolder}/player/tools"
      },
      "problemMatcher": [],
      "group": "build",
      "detail": "Cross-compile the continuous-video DVD -> MISTER_FB throughput test (dvd_video_test) with the VFPv3-safe toolchain."
    },
    {
      "label": "DVD Video Test: Deploy + Run on SS1",
      "type": "shell",
      "command": "./deploy_dvd_video_test.sh",
      "options": {
        "cwd": "${workspaceFolder}/player/tools"
      },
      "problemMatcher": [],
      "group": "test",
      "detail": "Build, scp and run dvd_video_test on the SS1: 500 frames unpaced through decode -> BGR0 -> DDR. Requires the DVD core loaded and a PAL DVD in /dev/sr0."
    },
    {
      "label": "DVD Double Video Test: Build (ARM cross-compile)",
      "type": "shell",
      "command": "./build_dvd_video_double_test.sh",
      "options": {
        "cwd": "${workspaceFolder}/player/tools"
      },
      "problemMatcher": [],
      "group": "build",
      "detail": "Cross-compile dvd_video_double_test: 500 PTS-paced frames through mailbox A/B. Does not modify dvd_video_test.c."
    },
    {
      "label": "DVD Double Video Test: Deploy + Run on SS1",
      "type": "shell",
      "command": "./deploy_dvd_video_double_test.sh",
      "options": {
        "cwd": "${workspaceFolder}/player/tools"
      },
      "problemMatcher": [],
      "group": "test",
      "detail": "Build, scp and run dvd_video_double_test on the SS1. Load the mailbox DVD.rbf, leave OSD Buffer on A, PAL DVD in /dev/sr0."
    },
    {
      "label": "DVD Audio Test: Build (ARM cross-compile)",
      "type": "shell",
      "command": "./build_dvd_audio_test.sh",
      "options": {
        "cwd": "${workspaceFolder}/player/tools"
      },
      "problemMatcher": [],
      "group": "build",
      "detail": "Cross-compile dvd_audio_test: ~20 s of title-2 audio through /dev/MrAudio. Does not modify dvd_video_double_test.c or FPGA."
    },
    {
      "label": "DVD Audio Test: Deploy + Run on SS1",
      "type": "shell",
      "command": "./deploy_dvd_audio_test.sh",
      "options": {
        "cwd": "${workspaceFolder}/player/tools"
      },
      "problemMatcher": [],
      "group": "test",
      "detail": "Build, scp and run dvd_audio_test on the SS1. Load DVD.rbf so alsa.sv consumes /dev/MrAudio. PAL DVD in /dev/sr0."
    },
    {
      "label": "DVD A/V Test: Build (ARM cross-compile)",
      "type": "shell",
      "command": "./build_dvd_av_test.sh",
      "options": {
        "cwd": "${workspaceFolder}/player/tools"
      },
      "problemMatcher": [],
      "group": "build",
      "detail": "Cross-compile dvd_av_test: ~30 s title-2 A/V with audio-master MrAudio clock. Does not replace the isolated video/audio tests."
    },
    {
      "label": "DVD A/V Test: Deploy + Run on SS1",
      "type": "shell",
      "command": "./deploy_dvd_av_test.sh",
      "options": {
        "cwd": "${workspaceFolder}/player/tools"
      },
      "problemMatcher": [],
      "group": "test",
      "detail": "Build, scp and run dvd_av_test on the SS1. Load mailbox DVD.rbf, leave OSD Buffer on A, PAL DVD in /dev/sr0."
    },
    {
      "label": "DVD A/V Threaded Test: Build (ARM cross-compile)",
      "type": "shell",
      "command": "./build_dvd_av_threaded_test.sh",
      "options": {
        "cwd": "${workspaceFolder}/player/tools"
      },
      "problemMatcher": [],
      "group": "build",
      "detail": "Cross-compile dvd_av_threaded_test: demux + audio/video worker threads. Leaves dvd_av_test.c as the failed single-thread proof."
    },
    {
      "label": "DVD A/V Threaded Test: Deploy + Run on SS1",
      "type": "shell",
      "command": "./deploy_dvd_av_threaded_test.sh",
      "options": {
        "cwd": "${workspaceFolder}/player/tools"
      },
      "problemMatcher": [],
      "group": "test",
      "detail": "Build, scp and run dvd_av_threaded_test on the SS1. Load mailbox DVD.rbf, leave OSD Buffer on A."
    },
    {
      "label": "Player: Deploy + Run on SS1",
      "type": "shell",
      "command": "./deploy-test.sh",
      "options": {
        "cwd": "${workspaceFolder}/player"
      },
      "problemMatcher": [],
      "group": "test",
      "detail": "Runs build_mac.sh, scp's the binary to the SS1, and runs it against /dev/sr0. Requires SSH access to the SS1."
    }
  ]
}
