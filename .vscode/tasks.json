{
  // Tasks that wrap the EXISTING player scripts. They do not change what the
  // scripts do; they only make them one-click runnable from the editor.
  // deploy-test.sh calls ./build_mac.sh and uses relative paths, so all tasks
  // run with cwd = player/.
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Player: Build (ARM cross-compile)",
      "type": "shell",
      "command": "./build_mac.sh",
      "options": {
        "cwd": "${workspaceFolder}/player"
      },
      "problemMatcher": [],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "detail": "Cross-compile dvdplayer_headless for SS1 (arm-unknown-linux-gnueabihf, VFPv3). Enforces the no-VFPv4 gate."
    },
    {
      "label": "FB Test: Build (ARM cross-compile)",
      "type": "shell",
      "command": "./build_fb_test.sh",
      "options": {
        "cwd": "${workspaceFolder}/player/tools"
      },
      "problemMatcher": [],
      "group": "build",
      "detail": "Cross-compile the minimal HPS framebuffer test (fb_native_test) with the VFPv3-safe toolchain."
    },
    {
      "label": "FB Test: Deploy + Run on SS1",
      "type": "shell",
      "command": "./deploy_fb_test.sh",
      "options": {
        "cwd": "${workspaceFolder}/player/tools"
      },
      "problemMatcher": [],
      "group": "test",
      "detail": "Build, scp and run fb_native_test on the SS1. Run from the MiSTer menu core so the framebuffer state can be restored."
    },
    {
      "label": "DDR Writer: Build (ARM cross-compile)",
      "type": "shell",
      "command": "./build_ddr_writer.sh",
      "options": {
        "cwd": "${workspaceFolder}/player/tools"
      },
      "problemMatcher": [],
      "group": "build",
      "detail": "Cross-compile the MISTER_FB DDR framebuffer writer (ddr_fb_writer) with the VFPv3-safe toolchain."
    },
    {
      "label": "DDR Writer: Deploy + Run on SS1",
      "type": "shell",
      "command": "./deploy_ddr_writer.sh",
      "options": {
        "cwd": "${workspaceFolder}/player/tools"
      },
      "problemMatcher": [],
      "group": "test",
      "detail": "Build, scp and run ddr_fb_writer on the SS1. Requires the DVD core (DVD.rbf) to be loaded first."
    },
    {
      "label": "DDR Double Writer: Build (ARM cross-compile)",
      "type": "shell",
      "command": "./build_ddr_double_writer.sh",
      "options": {
        "cwd": "${workspaceFolder}/player/tools"
      },
      "problemMatcher": [],
      "group": "build",
      "detail": "Cross-compile ddr_fb_double_writer: fills MISTER_FB buffers A and B with distinct static patterns."
    },
    {
      "label": "DDR Double Writer: Deploy + Run on SS1",
      "type": "shell",
      "command": "./deploy_ddr_double_writer.sh",
      "options": {
        "cwd": "${workspaceFolder}/player/tools"
      },
      "problemMatcher": [],
      "group": "test",
      "detail": "Build, scp and run ddr_fb_double_writer on the SS1. Load DVD.rbf first, then toggle Buffer A/B in the OSD."
    },
    {
      "label": "DVD Frame Test: Build (ARM cross-compile)",
      "type": "shell",
      "command": "./build_dvd_frame_test.sh",
      "options": {
        "cwd": "${workspaceFolder}/player/tools"
      },
      "problemMatcher": [],
      "group": "build",
      "detail": "Cross-compile the single-frame DVD -> MISTER_FB test (dvd_frame_test) with the VFPv3-safe toolchain. Requires FFmpeg libs from build_mac.sh."
    },
    {
      "label": "DVD Frame Test: Deploy + Run on SS1",
      "type": "shell",
      "command": "./deploy_dvd_frame_test.sh",
      "options": {
        "cwd": "${workspaceFolder}/player/tools"
      },
      "problemMatcher": [],
      "group": "test",
      "detail": "Build, scp and run dvd_frame_test on the SS1. Requires the DVD core loaded and a PAL DVD in /dev/sr0."
    },
    {
      "label": "DVD Video Test: Build (ARM cross-compile)",
      "type": "shell",
      "command": "./build_dvd_video_test.sh",
      "options": {
        "cwd": "${workspaceFolder}/player/tools"
      },
      "problemMatcher": [],
      "group": "build",
      "detail": "Cross-compile the continuous-video DVD -> MISTER_FB throughput test (dvd_video_test) with the VFPv3-safe toolchain."
    },
    {
      "label": "DVD Video Test: Deploy + Run on SS1",
      "type": "shell",
      "command": "./deploy_dvd_video_test.sh",
      "options": {
        "cwd": "${workspaceFolder}/player/tools"
      },
      "problemMatcher": [],
      "group": "test",
      "detail": "Build, scp and run dvd_video_test on the SS1: 500 frames unpaced through decode -> BGR0 -> DDR. Requires the DVD core loaded and a PAL DVD in /dev/sr0."
    },
    {
      "label": "Player: Deploy + Run on SS1",
      "type": "shell",
      "command": "./deploy-test.sh",
      "options": {
        "cwd": "${workspaceFolder}/player"
      },
      "problemMatcher": [],
      "group": "test",
      "detail": "Runs build_mac.sh, scp's the binary to the SS1, and runs it against /dev/sr0. Requires SSH access to the SS1."
    }
  ]
}
